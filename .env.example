# OpenAI -> https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Optional. Defaults to gpt-4.1-mini (best price/quality for this use case).
# OPENAI_MODEL=gpt-4.1-mini

# Telegram lead notifications:
# 1. Write to @BotFather -> /newbot -> copy the token
# 2. Send any message to your new bot
# 3. Open https://api.telegram.org/bot<TOKEN>/getUpdates and copy result[0].message.chat.id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Google Calendar booking (chat bot "book a call" flow):
# 1. Create a Google Cloud project -> https://console.cloud.google.com/projectcreate
# 2. Enable the Google Calendar API for it (APIs & Services -> Enable APIs -> "Google Calendar API")
# 3. Configure the OAuth consent screen (APIs & Services -> OAuth consent screen).
#    IMPORTANT: set Publishing status to "In production" — while it is "Testing",
#    refresh tokens expire after 7 days and booking will silently stop working.
# 4. Create an OAuth client (APIs & Services -> Credentials -> Create credentials ->
#    OAuth client ID -> Application type: Web application). Add
#    http://localhost:5555/callback as an authorized redirect URI.
# 5. Copy the client ID and secret below, then run: node scripts/google-auth.mjs
#    Sign in as the calendar owner and approve access — the script prints the
#    refresh token to paste in as GOOGLE_REFRESH_TOKEN.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Optional. Defaults to "primary" (the calendar owner's main calendar).
# GOOGLE_CALENDAR_ID=primary

# Your Google account email. Lists you as an accepted guest on booked events,
# so the visitor sees the call is confirmed. Not needed if GOOGLE_CALENDAR_ID
# is already set to your email address.
# BOOKING_OWNER_EMAIL=serhiy.kushnir.dev@gmail.com

# Optional, comma-separated. Extra calendars whose events also block booking
# slots (e.g. a personal calendar), without bot events being created there.
# GOOGLE_BUSY_CALENDAR_IDS=
